# NEXORA AI — Environment Configuration

# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Google Gemini API Configuration (Official @google/genai SDK)
# Configured server-side only. Never exposed to Electron frontend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database Persistence
# In cloud/VPS: postgresql://postgres:password@postgres:5432/nexora
# In local dev: Leave empty to automatically use zero-config SQLite at D:/nexora-ai/data/nexora.db
DATABASE_URL=

# Durable Task Queue (Redis + BullMQ)
# In cloud/VPS: redis://redis:6379
# In local dev: Leave empty to automatically use built-in persistent DB queue engine
REDIS_URL=

# Storage and Sandboxing
STORAGE_DIR=D:/nexora-ai/storage
DATA_DIR=D:/nexora-ai/data
WORKSPACE_DIR=D:/nexora-ai/workspaces

# Security & Secret Key
JWT_SECRET=nexora-cloud-super-secret-key-change-in-production

# Live Remote Preview
SCREENSHOT_INTERVAL_MS=1500
